<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PageSetupAgent"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="启用">
                <StackPanel Margin="25,40,25,18">
                    <local:MyCheckBox local:SettingService.Key="AgentEnabled" Text="启用 AI 助理「小瑟」（桌面显示悬浮人偶）" Height="22" Margin="-1,0,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="AI 助理「小瑟」">
                <StackPanel Margin="25,40,25,20">
                    <Grid Height="28" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="提供商" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Column="1" local:SettingService.Key="AgentProvider">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="OpenAI" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="DeepSeek" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="智谱 GLM" />
                            <local:MyComboBoxItem local:SettingService.Value="3" Content="月之暗面" />
                            <local:MyComboBoxItem local:SettingService.Value="4" Content="硅基流动" />
                            <local:MyComboBoxItem local:SettingService.Value="5" Content="OpenRouter" />
                            <local:MyComboBoxItem local:SettingService.Value="6" Content="Ollama（本地）" />
                            <local:MyComboBoxItem local:SettingService.Value="7" Content="自定义" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid Height="28" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="接口地址" Margin="0,0,25,0" />
                        <local:MyTextBox Grid.Column="1" local:SettingService.Key="AgentBaseUrl" HintText="切换提供商会自动填写" />
                    </Grid>
                    <Grid Height="28" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="模型" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboAgentModel" Grid.Column="1" IsEditable="True" Height="28" Margin="0,0,10,0" HintText="可手动填写，或点右侧获取" />
                        <local:MyButton x:Name="BtnGetModels" Grid.Column="2" Text="获取模型" MinWidth="90" Height="28" Padding="10,0" />
                    </Grid>
                    <Grid Height="28" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="API Key" Margin="0,0,25,0" />
                        <local:MyTextBox Grid.Column="1" local:SettingService.Key="AgentApiKey" HintText="仅保存在本机，不会上传" />
                    </Grid>
                    <Grid Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="安全策略" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Column="1" local:SettingService.Key="AgentSafety">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="严格：所有操作都需确认" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="标准：仅高风险操作需确认" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="宽松：所有操作自动执行，不再询问" />
                        </local:MyComboBox>
                    </Grid>
                    <local:MyCheckBox local:SettingService.Key="AgentAllowLocalNet" Text="允许小瑟访问本机与内网地址" Margin="-1,14,0,0" Height="22" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
