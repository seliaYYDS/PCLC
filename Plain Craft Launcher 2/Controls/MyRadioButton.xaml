<Border x:Name="PanBack" x:Class="MyRadioButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource ColorBrushSemiTransparent}" CornerRadius="13.5" MinHeight="27" MaxHeight="27">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColLogo" Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Path x:Name="ShapeLogo" Grid.Column="0" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Margin="12,0,0,0" Stretch="Uniform" Fill="White" MaxHeight="16" MaxWidth="16" VerticalAlignment="Center" />
        <TextBlock x:Name="LabText" Grid.Column="1" VerticalAlignment="Center" Foreground="White" Margin="8,0,12,0" SnapsToDevicePixels="False" UseLayoutRounding="False" />
    </Grid>
</Border>
